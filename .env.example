# Agent-Ready Audit — przykładowa konfiguracja.
# Skopiuj do .env (cp .env.example .env) i uzupełnij. NIGDY nie commituj .env — repo jest publiczne.

# --- Agenci: backend ---
# claude_sdk (domyślny): sesje Claude Code przez claude-agent-sdk na Twojej subskrypcji Claude (Pro/Max), bez klucza API
# claude_cli: to samo przez `claude -p --output-format stream-json` (zapas / debug)
# api: biblioteka browser-use z modelem przez klucz API (opcjonalnie, wymaga klucza poniżej)
AGENT_BACKEND=claude_sdk
# Serwer MCP przeglądarki: browser_use (browser-use --mcp) | playwright (@playwright/mcp)
BROWSER_MCP=browser_use

# --- Subskrypcja Claude ---
# Wystarczy zalogowany Claude Code na tym komputerze (`claude`, potem /login).
# Albo token z `claude setup-token` (ważny rok). Tylko do użytku osobistego, nigdy do repo.
CLAUDE_CODE_OAUTH_TOKEN=
# Model agentów i sędziego: alias haiku | sonnet | opus
CLAUDE_MODEL=sonnet
CLAUDE_JUDGE_MODEL=sonnet

# --- Backend "api" (opcjonalny, tylko jeśli kiedyś będzie klucz) ---
# LLM_MODEL=anthropic:<model> | openai:<model> | google:<model> | ollama:<model>
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Bezpieczeństwo ---
# Domeny, które wolno audytować (po przecinku). Puste = worker odrzuci każdy audyt.
ALLOWED_TARGET_DOMAINS=

# --- Koszty i limity ---
# Budżet jednego audytu w "równowartości API" (USD, szacunek z Claude Code — przy subskrypcji to miara zużycia, nie rachunek)
AUDIT_BUDGET_USD=5.00
# Dzienny limit w tej samej mierze
DAILY_BUDGET_USD=20.00
# Ile sesji Claude naraz. Limity subskrypcji Pro/Max szybko się kończą przy większym roju: zalecane 2–3
SWARM_CONCURRENCY=2
# Maksymalna liczba żądań na sekundę do jednej domeny (łącznie dla skanera i agentów)
PER_DOMAIN_RPS=1

# --- Aplikacja ---
DATABASE_URL=sqlite:///data/agent_ready.db
ARTIFACTS_DIR=data/artifacts
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Konta testowe dla zadań wymagających logowania (credentials_ref w YAML zadania) ---
# TEST_ACCOUNT_1_USERNAME=
# TEST_ACCOUNT_1_PASSWORD=
