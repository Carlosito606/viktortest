# Agent-Ready Audit — przykładowa konfiguracja.
# Skopiuj do .env (cp .env.example .env) i uzupełnij. NIGDY nie commituj .env — repo jest publiczne.

# --- Model LLM dla agentów (format provider:nazwa) ---
# Przykłady: anthropic:claude-haiku-4-5 | openai:<model> | google:<model> | ollama:<model>
# Nazwy modeli zmieniają się często — sprawdź aktualną listę u dostawcy.
LLM_MODEL=anthropic:claude-haiku-4-5
# Opcjonalnie mocniejszy model dla sędziego / trudnych zadań (puste = jak LLM_MODEL)
LLM_JUDGE_MODEL=

# --- Klucze API (wypełnij tylko ten, którego używasz) ---
# Anthropic: klucz z console.anthropic.com (subskrypcja Claude Code/Pro nie daje klucza API)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Lokalny model przez Ollama (zgodny z API OpenAI)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Bezpieczeństwo ---
# Domeny, które wolno audytować (po przecinku). Puste = worker odrzuci każdy audyt.
ALLOWED_TARGET_DOMAINS=

# --- Koszty i limity ---
# Domyślny budżet jednego audytu w USD
AUDIT_BUDGET_USD=5.00
# Globalny dzienny limit wydatków na LLM w USD
DAILY_BUDGET_USD=20.00
# Ile przeglądarek naraz (każdy Chromium to ok. 300–500 MB RAM)
SWARM_CONCURRENCY=3
# Maksymalna liczba żądań na sekundę do jednej domeny (łącznie dla skanera i agentów)
PER_DOMAIN_RPS=1

# --- Aplikacja ---
DATABASE_URL=sqlite:///data/agent_ready.db
ARTIFACTS_DIR=data/artifacts
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Konta testowe dla zadań wymagających logowania (credentials_ref w YAML zadania) ---
# TEST_ACCOUNT_1_USERNAME=
# TEST_ACCOUNT_1_PASSWORD=
